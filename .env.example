SECRET_KEY=replace-with-a-long-random-value
DEBUG=False
ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
SQLITE_PATH=/absolute/persistent/path/db.sqlite3
SQLITE_TIMEOUT=30
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=ROCKS ELECTRIC <no-reply@example.com>
ORDER_NOTIFICATION_EMAIL=orders@example.com
ERROR_NOTIFICATION_EMAIL=errors@example.com
CART_SHIPPING_COST=75.00
FREE_SHIPPING_THRESHOLD=1500.00
LOG_LEVEL=INFO
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
CACHE_LOCATION=/absolute/persistent/path/cache
TRUST_PROXY_HEADERS=False
BACKUP_DIRECTORY=/absolute/persistent/backups
LEGAL_CONTENT_APPROVED=False
